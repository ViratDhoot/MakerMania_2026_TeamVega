int8_t MAPPING[4][2] = {
  { 1, 0 }, { -1, 0 }, { 0, -1 }, { 0, 1 }
};
uint8_t DIM[2] = { 10, 10 };

void drawMaze(uint8_t maze[MAZE_W][MAZE_H], int ix, int iy) {
  int x = (SCREEN_WIDTH / 2) - ix;
  int y = (SCREEN_HEIGHT / 2) - iy;

  uint8_t cell, cx, cy;

  for (int i = max((ix / DIM[0]) - 5, 0); i < min(MAZE_W, (ix / DIM[0]) + 5); i++) {
    for (int j = max((iy / DIM[1]) - 5, 0); j < min(MAZE_H, (iy / DIM[1]) + 5); j++) {
      cell = maze[i][j];
      cx = (i * DIM[0]) + x;
      cy = (j * DIM[1]) + y;
      if ((cell & TOP) == 0)
        display.drawLine(cx, cy, cx + DIM[0], cy, SWHITE);
      if ((cell & LEFT) == 0)
        display.drawLine(cx, cy, cx, cy + DIM[1], SWHITE);
      if (i == MAZE_W - 1)
        display.drawLine(cx + DIM[0] - 1, cy, cx + DIM[0] - 1, cy + DIM[1], SWHITE);
      if (j == MAZE_H - 1)
        display.drawLine(cx, cy + DIM[1] - 1, cx + DIM[0], cy + DIM[1] - 1, SWHITE);
    }
  }
}

float x = DIM[0] / 2.0;
float y = DIM[1] / 2.0;

float speed = 1.0;
int size = 2;
int ix, iy;
int cell;
float mag;
float arrow[2];

void loop() {
  display.clearDisplay();
  drawMaze(arr, x, y);
  float joyX = (analogRead(JOY_X) - 2047.5f) / 2047.5f;
  float joyY = (analogRead(JOY_Y) - 2047.5f) / 2047.5f;

  if (abs(joyX) < 0.10f)
    joyX = 0;

  if (abs(joyY) < 0.10f)
    joyY = 0;

  x += joyX * speed;
  y += joyY * speed;

  ix = int(x / DIM[0]);
  iy = int(y / DIM[1]);

  ix = constrain(ix, 0, MAZE_W - 1);
  iy = constrain(iy, 0, MAZE_H - 1);

  cell = arr[ix][iy];
  if (((cell & LEFT) == 0) && ((x - size) < (ix * DIM[0] + 1)))
    x = ix * DIM[0] + size + 1;
  if (((cell & RIGHT) == 0) && ((x + size) > ((ix + 1) * DIM[0] - 1)))
    x = (ix + 1) * DIM[0] - size - 1;
  if (((cell & TOP) == 0) && ((y - size) < (iy * DIM[1] + 1)))
    y = iy * DIM[1] + size + 1;
  if (((cell & BOTTOM) == 0) && ((y + size) > ((iy + 1) * DIM[1] - 1)))
    y = (iy + 1) * DIM[1] - size - 1;
  display.fillCircle(SCREEN_WIDTH / 2, SCREEN_HEIGHT / 2, size, SWHITE);
  arrow[0] = MAZE_W / 2 - x / DIM[0];
  arrow[1] = MAZE_H / 2 - y / DIM[1];
  mag = sqrt(
    arrow[0] * arrow[0] + arrow[1] * arrow[1]);
  if (abs(mag) > 3) {
    arrow[0] /= mag;
    arrow[1] /= mag;

    arrow[0] *= SCREEN_WIDTH / 2;
    arrow[1] *= SCREEN_HEIGHT / 2;

    arrow[0] += SCREEN_WIDTH / 2;
    arrow[1] += SCREEN_HEIGHT / 2;

    display.fillCircle(
      (int)arrow[0],
      (int)arrow[1],
      1,
      SWHITE);
  }
  display.display();
  if (!digitalRead(JOY_SW)) {
    Serial.println("Pressed");
  }
}