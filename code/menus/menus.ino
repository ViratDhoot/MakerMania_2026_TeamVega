void drawButton(int x, int y, char *text, bool selected) {
  int16_t px, py;
  uint16_t w, h;

  display.getTextBounds(text, 0, 0, &px, &py, &w, &h);
  px = x - (w / 2);
  py = y - (h / 2);
  int m = 3; // margin
  if (selected) {
    display.fillRoundRect(px-m, py - m, w + 2*m, h + 2 * m, 3, SWHITE);
    display.setTextColor(SBLACK);
  } else {
    display.setTextColor(SWHITE);
    display.drawRoundRect(px-m, py - m, w + 2*m, h + 2 * m, 3, SWHITE);
  }
  display.setTextSize(1);
  display.setCursor(px, py);
  display.println(text);
}

void loop() {
  display.clearDisplay();

  display.drawBitmap(0, 3, epd_bitmap_Bitmap, 128, 26, SWHITE);
  drawButton(64, 45, "Start", true);
  
  display.display();
}